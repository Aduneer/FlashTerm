#!/bin/sh
#
# Stands in for piper, so that the --voice path can be tested on a machine that
# does not have it -- which includes CI, and includes anyone who has not gone
# and installed it. Accepts the two arguments FlashTerm builds, "-m <model>" and
# "-f <out>", and writes the text it was given on standard input to <out>, the
# same way fake-audio.sh does for the FLASHTERM_TTS_RENDER path.

# Fails on demand, so that a case can test what someone is told when rendering
# goes wrong. "pyopenjtalk" reproduces the real thing: piper's Japanese voices
# phonemize through a package it does not install, and the failure arrives as a
# Python traceback whose last line is the only useful part of it.
if [ -n "${FAKE_PIPER_FAIL:-}" ]; then
  cat >/dev/null
  if [ "$FAKE_PIPER_FAIL" = pyopenjtalk ]; then
    cat >&2 <<'ERR'
Traceback (most recent call last):
  File "piper/voice.py", line 243, in phonemize
    phonemizer = JapanesePhonemizer()
  File "piper/phonemize_japanese.py", line 141, in __init__
    import pyopenjtalk
ModuleNotFoundError: No module named 'pyopenjtalk'
ERR
  else
    printf '%s\n' "$FAKE_PIPER_FAIL" >&2
  fi
  exit 1
fi

out=
model=
while [ $# -gt 0 ]; do
  case $1 in
    -f) out=$2; shift 2 ;;
    -m) model=$2; shift 2 ;;
    *) shift ;;
  esac
done

[ -n "$out" ] || exit 2
cat >"$out"
printf 'piper: %s  (%s)\n' "$out" "$(basename "$model")" >>played.txt
